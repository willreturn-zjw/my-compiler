decl @getint():i32
decl @getch():i32
decl @getarray(*i32):i32
decl @getfloat():f32
decl @getfarray(*f32):i32
decl @putint(i32)
decl @putch(i32)
decl @putarray(i32,*i32)
decl @putfloat(f32)
decl @putfarray(i32,*f32)
decl @_sysy_starttime(i32)
decl @_sysy_stoptime(i32)

fun @main() : i32 { 
%entry:
@a = alloc i32 

store 7, @a
%0= load @a
call @putint(%0)
ret 0
 }
